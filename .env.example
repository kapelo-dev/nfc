DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=nfc_cards_db
DB_PORT=3306
# Production: TLS is on by default. Local MySQL: leave unset. Disable with DB_SSL=false
# DB_SSL=true
# DB_SSL_REJECT=true

# Required: random string, 32+ characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

ADMIN_USERNAME=admin
# Required: 12+ characters, not a common password (admin123 is rejected)
ADMIN_PASSWORD=

PORT=3000
NODE_ENV=development

BASE_DOMAIN=localhost:3000

# Required for photo upload (routes/upload.js): https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: GoWA (go-whatsapp-web-multidevice) instance for WhatsApp notifications.
# Leave empty to disable — the app works fine without it, notifications are just skipped.
# Base URL of your deployed GoWA instance, no trailing slash (e.g. https://gowa.example.com)
GOWA_BASE_URL=
# HTTP Basic Auth credentials configured on your GoWA instance
GOWA_BASIC_AUTH_USER=
GOWA_BASIC_AUTH_PASSWORD=
# Your own WhatsApp number (admin) that receives order + print notifications, digits only with country code (e.g. 22897223445)
GOWA_ADMIN_PHONE=
