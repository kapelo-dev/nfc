<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', sans-serif;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 24px;
      color: #fff;
      background: linear-gradient(180deg, #fb923c 0%, #f472b6 48%, #7c3aed 100%);
    }
    .card { width: min(380px, 100%); text-align: center; }
    .profile-photo, .default-avatar {
      width: 120px; height: 120px; border-radius: 50%;
      object-fit: cover; margin: 0 auto 20px;
      border: 3px solid rgba(255,255,255,0.75);
    }
    .profile-photo { display: block; }
    .default-avatar { background: rgba(255,255,255,0.18); display: grid; place-items: center; }
    .default-avatar i { font-size: 36px; }
    .profile-name {
      font-family: 'Fraunces', serif;
      font-size: 2.1rem; font-weight: 500; letter-spacing: -0.03em;
    }
    .profile-title { margin-top: 6px; font-weight: 500; opacity: 0.9; }
    .profile-bio { margin: 16px auto 0; max-width: 34ch; font-size: 0.95rem; line-height: 1.65; opacity: 0.92; }
    .social-grid { margin-top: 28px; display: flex; flex-direction: column; gap: 10px; }
    .social-link {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      padding: 14px; border-radius: 999px; text-decoration: none; color: #fff;
      background: rgba(255,255,255,0.16); border: 1px solid rgba(255,255,255,0.4);
      font-weight: 600; font-size: 0.9rem; backdrop-filter: blur(8px);
      transition: 0.2s;
    }
    .social-link:hover { background: #fff; color: #c2410c; }
    .no-social { margin-top: 20px; opacity: 0.8; }
  </style>
</head>
<body>
  <article class="card">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
  </article>
</body>
</html>
