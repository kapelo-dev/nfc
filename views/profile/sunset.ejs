<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'DM Sans', sans-serif;
      background: linear-gradient(180deg, #fb923c 0%, #f472b6 50%, #c084fc 100%);
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 24px; color: #fff;
    }
    .card { max-width: 420px; width: 100%; text-align: center; }
    .profile-photo, .default-avatar {
      width: 132px; height: 132px; border-radius: 50%;
      object-fit: cover; margin: 0 auto 18px;
      border: 4px solid rgba(255,255,255,0.85);
      box-shadow: 0 16px 40px rgba(0,0,0,0.18);
    }
    .profile-photo { display: block; }
    .default-avatar { background: rgba(255,255,255,0.25); display: flex; align-items: center; justify-content: center; margin-left: auto; margin-right: auto; }
    .default-avatar i { font-size: 52px; }
    .profile-name { font-size: 30px; font-weight: 700; }
    .profile-title { font-weight: 500; opacity: 0.95; margin: 6px 0 14px; }
    .profile-bio { font-size: 15px; line-height: 1.7; opacity: 0.92; margin-bottom: 28px; }
    .social-grid { display: flex; flex-direction: column; gap: 10px; }
    .social-link {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      padding: 15px; border-radius: 999px; text-decoration: none;
      background: rgba(255,255,255,0.2); color: #fff;
      border: 1.5px solid rgba(255,255,255,0.5);
      font-weight: 600; font-size: 14px; backdrop-filter: blur(8px);
      transition: 0.2s;
    }
    .social-link:hover { background: #fff; color: #ea580c; }
    .no-social { opacity: 0.8; }
    .footer { margin-top: 24px; font-size: 12px; opacity: 0.75; }
  </style>
</head>
<body>
  <div class="card">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
    <p class="footer">golden hour ☀</p>
  </div>
</body>
</html>
