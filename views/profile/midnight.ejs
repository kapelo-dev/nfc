<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root { --accent: <%= theme.color %>; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', sans-serif;
      background: #050505;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 32px 16px;
      color: #f4f4f5;
    }
    .card { width: min(400px, 100%); text-align: center; }
    .ring {
      width: 108px; height: 108px; margin: 0 auto 24px;
      border-radius: 50%; padding: 3px;
      background: conic-gradient(from 210deg, var(--accent), transparent 40%, var(--accent));
    }
    .profile-photo, .default-avatar {
      width: 100%; height: 100%; border-radius: 50%; object-fit: cover;
      border: 3px solid #050505; background: #111;
    }
    .default-avatar { display: grid; place-items: center; }
    .default-avatar i { color: var(--accent); font-size: 32px; }
    .profile-name { font-size: 1.55rem; font-weight: 600; letter-spacing: -0.03em; }
    .profile-title { margin-top: 8px; font-size: 0.82rem; color: var(--accent); font-weight: 500; }
    .profile-bio { margin: 18px auto 0; max-width: 36ch; font-size: 0.9rem; line-height: 1.65; color: #a1a1aa; }
    .social-grid { margin-top: 32px; display: flex; flex-direction: column; gap: 8px; }
    .social-link {
      display: flex; align-items: center; gap: 12px;
      padding: 14px 16px; border-radius: 14px;
      text-decoration: none; color: #fafafa;
      background: #0c0c0c; border: 1px solid #1c1c1c;
      font-size: 0.9rem; font-weight: 500; transition: 0.2s;
    }
    .social-link span { flex: 1; text-align: left; }
    .social-link i { width: 18px; color: var(--accent); }
    .social-link:hover { border-color: var(--accent); background: #111; }
    .no-social { margin-top: 28px; color: #3f3f46; }
  </style>
</head>
<body>
  <article class="card">
    <div class="ring"><%- include('partials/avatar') %></div>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
  </article>
</body>
</html>
