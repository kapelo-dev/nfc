<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600&family=Outfit:wght@400;500&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', sans-serif;
      background: #faf7f6;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 24px;
      color: #3d2c30;
    }
    .card {
      width: min(400px, 100%);
      text-align: center;
      padding: 48px 24px;
    }
    .profile-photo, .default-avatar {
      width: 96px; height: 96px; border-radius: 50%;
      object-fit: cover; margin: 0 auto 28px;
    }
    .profile-photo { display: block; }
    .default-avatar { background: #f1e4e6; display: grid; place-items: center; }
    .default-avatar i { color: #d4a5ad; }
    .profile-name {
      font-family: 'Shippori Mincho', serif;
      font-size: 2rem; font-weight: 600;
    }
    .profile-title { margin-top: 10px; font-size: 0.8rem; letter-spacing: 0.22em; text-transform: uppercase; color: #c48b94; }
    .profile-bio { margin: 20px auto 0; max-width: 34ch; font-size: 0.92rem; line-height: 1.85; color: #6b5358; }
    .social-grid { margin-top: 36px; display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
    .social-link {
      width: 44px; height: 44px; border-radius: 50%;
      display: grid; place-items: center;
      text-decoration: none; color: #3d2c30;
      border: 1px solid #ead7da; transition: 0.2s;
    }
    .social-link span { display: none; }
    .social-link:hover { background: #3d2c30; color: #faf7f6; border-color: #3d2c30; }
    .no-social { margin-top: 28px; color: #c4b0b4; }
  </style>
</head>
<body>
  <article class="card">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
  </article>
</body>
</html>
