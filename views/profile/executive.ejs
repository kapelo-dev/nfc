<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Outfit:wght@400;500&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', sans-serif;
      background: #ece8e1;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 24px;
      color: #1c1915;
    }
    .sheet {
      width: min(720px, 100%);
      display: grid;
      grid-template-columns: 280px 1fr;
      min-height: 520px;
      background: #f7f4ee;
      border: 1px solid #d9d0c3;
    }
    .pane {
      background: #1a2332;
      color: #f7f4ee;
      padding: 48px 32px;
      display: flex; flex-direction: column; justify-content: center; align-items: center;
      text-align: center;
    }
    .profile-photo, .default-avatar {
      width: 140px; height: 168px; object-fit: cover;
      border-radius: 0; margin-bottom: 28px;
      filter: grayscale(0.15) contrast(1.05);
    }
    .profile-photo { display: block; }
    .default-avatar { background: #243044; display: grid; place-items: center; }
    .default-avatar i { font-size: 42px; color: #c4a574; }
    .profile-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem; font-weight: 500; line-height: 1.1;
    }
    .profile-title {
      margin-top: 12px; font-size: 0.68rem; letter-spacing: 0.28em;
      text-transform: uppercase; color: #c4a574;
    }
    .copy { padding: 56px 44px; display: flex; flex-direction: column; justify-content: center; }
    .rule { width: 40px; height: 1px; background: #c4a574; margin-bottom: 24px; }
    .profile-bio { font-size: 0.95rem; line-height: 1.75; color: #5c564c; margin-bottom: 36px; }
    .kicker { font-size: 0.65rem; letter-spacing: 0.22em; text-transform: uppercase; color: #9a9184; margin-bottom: 16px; }
    .social-grid { display: flex; flex-direction: column; }
    .social-link {
      display: flex; align-items: center; gap: 14px;
      padding: 12px 0; text-decoration: none; color: #1a2332;
      border-bottom: 1px solid #e6dfd4; font-size: 0.88rem; font-weight: 500;
      transition: 0.2s;
    }
    .social-link:last-child { border-bottom: 0; }
    .social-link i { width: 16px; color: #c4a574; font-size: 0.85rem; }
    .social-link:hover { color: #c4a574; padding-left: 6px; }
    .no-social { color: #9a9184; }
    @media (max-width: 680px) {
      .sheet { grid-template-columns: 1fr; }
      .pane { padding: 40px 24px; }
      .copy { padding: 36px 28px 44px; }
      .profile-photo, .default-avatar { width: 112px; height: 134px; }
    }
  </style>
</head>
<body>
  <article class="sheet">
    <aside class="pane">
      <%- include('partials/avatar') %>
      <h1 class="profile-name"><%= card.name %></h1>
      <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    </aside>
    <div class="copy">
      <div class="rule"></div>
      <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
      <p class="kicker">Correspondance</p>
      <%- include('partials/social') %>
    </div>
  </article>
</body>
</html>
