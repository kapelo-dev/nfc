<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Source Sans 3', sans-serif;
      background: #e8eef4;
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
    }
    .wrap {
      display: grid;
      grid-template-columns: 240px 1fr;
      max-width: 720px; width: 100%;
      background: #fff;
      box-shadow: 0 25px 60px rgba(15,23,42,0.18);
      min-height: 480px;
    }
    .side {
      background: #0f172a;
      color: #fff;
      padding: 40px 28px;
      text-align: center;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
    }
    .profile-photo, .default-avatar {
      width: 110px; height: 110px; border-radius: 4px;
      object-fit: cover; margin-bottom: 20px;
      border: 2px solid #c9a227;
    }
    .default-avatar { background: #1e293b; display: flex; align-items: center; justify-content: center; }
    .default-avatar i { font-size: 48px; color: #c9a227; }
    .profile-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 28px; font-weight: 600; letter-spacing: 0.5px;
    }
    .profile-title {
      color: #c9a227; font-size: 12px; letter-spacing: 2.5px;
      text-transform: uppercase; margin-top: 10px;
    }
    .main { padding: 48px 40px; display: flex; flex-direction: column; justify-content: center; }
    .profile-bio { color: #475569; line-height: 1.7; font-size: 15px; margin-bottom: 32px; }
    .label {
      font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
      color: #94a3b8; margin-bottom: 16px;
    }
    .social-grid { display: flex; flex-direction: column; gap: 10px; }
    .social-link {
      display: flex; align-items: center; gap: 12px;
      padding: 12px 16px; text-decoration: none; color: #0f172a;
      border: 1px solid #e2e8f0; font-weight: 500; font-size: 14px;
      transition: 0.2s;
    }
    .social-link:hover { border-color: #c9a227; background: #faf8f2; }
    .social-link i { width: 20px; text-align: center; color: #c9a227; }
    .snapchat i, .tiktok i, .whatsapp i, .linkedin i, .instagram i, .facebook i { color: #c9a227; }
    .no-social { color: #94a3b8; font-style: italic; }
    .footer { margin-top: 28px; font-size: 11px; color: #cbd5e1; }
    @media (max-width: 640px) {
      .wrap { grid-template-columns: 1fr; }
      .side { padding: 36px 24px; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <aside class="side">
      <%- include('partials/avatar') %>
      <h1 class="profile-name"><%= card.name %></h1>
      <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    </aside>
    <div class="main">
      <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
      <p class="label">Contact</p>
      <%- include('partials/social') %>
      <p class="footer">NFC Card Manager</p>
    </div>
  </div>
</body>
</html>
