<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,500&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root { --accent: <%= theme.color %>; --r: <%= theme.rgb.r %>; --g: <%= theme.rgb.g %>; --b: <%= theme.rgb.b %>; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Karla', sans-serif; background: #faf8f4; display: flex; justify-content: center; color: #3a362f; }
    .wrap { width: min(390px, 100%); padding: 56px 30px 48px; display: flex; flex-direction: column; align-items: center; text-align: center; }
    .profile-photo, .default-avatar {
      width: 100px; height: 100px; border-radius: 50%; object-fit: cover;
      background: #f1ede4; box-shadow: 0 10px 26px -14px rgba(58,54,47,0.28); flex-shrink: 0;
    }
    .default-avatar { display: grid; place-items: center; }
    .default-avatar i { font-size: 36px; color: var(--accent); }
    .profile-name { margin: 24px 0 0; font-family: 'Lora', serif; font-weight: 600; font-style: italic; font-size: 29px; color: #2c291f; }
    .profile-title { margin: 10px 0 0; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }
    .rule { width: 30px; height: 1px; background: #ddd6c8; margin: 22px 0; }
    .profile-bio { font-size: 14.5px; line-height: 1.7; color: #6b6656; max-width: 30ch; }
    .social-grid { margin-top: 34px; width: 100%; display: flex; flex-direction: column; align-items: center; gap: 10px; }
    .social-link {
      width: 100%; max-width: 280px; box-sizing: border-box;
      display: flex; align-items: center; justify-content: center; gap: 10px;
      padding: 13px; border-radius: 999px; background: #f4f1ea; border: 1px solid #eae5d8;
      text-decoration: none; font-size: 13.5px; font-weight: 600; color: #3a362f;
      transition: background 0.15s, border-color 0.15s;
    }
    .social-link i { color: #5c5847; }
    .social-link:hover { background: #fff; border-color: var(--accent); }
    .no-social { margin-top: 20px; color: #9a9484; font-size: 0.85rem; }
    .footer-note { margin-top: 36px; font-size: 10.5px; letter-spacing: 0.1em; color: #b3ac99; }
  </style>
</head>
<body>
  <div class="wrap">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <div class="rule"></div>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
    <p class="footer-note">Carte NFC &#8226; Digital</p>
  </div>
</body>
</html>
