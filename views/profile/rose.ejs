<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', sans-serif;
      background: #9d174d;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 24px;
      color: #fff;
    }
    .card { width: min(400px, 100%); text-align: left; }
    .profile-photo, .default-avatar {
      width: 100%; height: 280px; border-radius: 4px;
      object-fit: cover; margin-bottom: 28px;
    }
    .profile-photo { display: block; }
    .default-avatar { background: rgba(255,255,255,0.12); display: grid; place-items: center; }
    .default-avatar i { font-size: 48px; opacity: 0.7; }
    .profile-name {
      font-family: 'Playfair Display', serif;
      font-size: 2.6rem; font-weight: 500; line-height: 1.05;
    }
    .profile-title { margin-top: 10px; font-size: 0.78rem; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.8; }
    .profile-bio { margin-top: 18px; font-size: 0.95rem; line-height: 1.65; opacity: 0.88; }
    .social-grid { margin-top: 32px; display: flex; flex-direction: column; gap: 8px; }
    .social-link {
      display: flex; align-items: center; gap: 12px;
      padding: 14px 16px; text-decoration: none; color: #9d174d;
      background: #fff; font-weight: 600; font-size: 0.9rem;
      transition: 0.2s;
    }
    .social-link span { flex: 1; }
    .social-link:hover { transform: translateX(4px); }
    .no-social { margin-top: 20px; opacity: 0.7; }
  </style>
</head>
<body>
  <article class="card">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
  </article>
</body>
</html>
