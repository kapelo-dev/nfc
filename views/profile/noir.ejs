<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@400;500&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Barlow', sans-serif;
      background: #0a0a0a;
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 0;
      color: #e8e8e8;
    }
    .hero {
      width: 100%; max-width: 560px;
      min-height: 100vh;
      background: linear-gradient(180deg, #1a1a1a 0%, #000 100%);
      padding: 60px 32px 40px;
      display: flex; flex-direction: column; align-items: center;
    }
    .profile-photo, .default-avatar {
      width: 140px; height: 180px; border-radius: 0;
      object-fit: cover; filter: grayscale(1) contrast(1.1);
      margin-bottom: 28px;
    }
    .profile-photo { display: block; }
    .default-avatar { background: #222; display: flex; align-items: center; justify-content: center; }
    .default-avatar i { font-size: 56px; color: #444; }
    .profile-name {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 48px; letter-spacing: 4px; line-height: 1;
    }
    .profile-title { color: #888; font-size: 13px; letter-spacing: 4px; text-transform: uppercase; margin: 8px 0 20px; }
    .profile-bio { color: #999; max-width: 360px; text-align: center; line-height: 1.7; margin-bottom: 36px; font-size: 15px; }
    .social-grid { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
    .social-link {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 16px; text-decoration: none; color: #fff;
      border: 1px solid #333; font-size: 12px; letter-spacing: 1px;
      text-transform: uppercase; transition: 0.2s;
    }
    .social-link:hover { background: #fff; color: #000; }
    .no-social { color: #444; }
    .footer { margin-top: auto; padding-top: 40px; font-size: 10px; letter-spacing: 3px; color: #333; }
  </style>
</head>
<body>
  <div class="hero">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
    <p class="footer">NFC</p>
  </div>
</body>
</html>
