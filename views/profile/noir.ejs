<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Source Serif 4', serif;
      background: #000;
      min-height: 100vh;
      color: #e8e4dc;
    }
    .stage {
      width: min(480px, 100%);
      margin: 0 auto;
      min-height: 100vh;
      display: flex; flex-direction: column;
    }
    .still {
      height: 42vh; min-height: 240px;
      background: #111;
      overflow: hidden;
      display: grid; place-items: center;
    }
    .profile-photo {
      width: 100%; height: 100%; object-fit: cover;
      filter: grayscale(1) contrast(1.15) brightness(0.92);
    }
    .default-avatar {
      width: 100%; height: 100%; background: #161616;
      display: grid; place-items: center;
    }
    .default-avatar i { font-size: 48px; color: #333; }
    .meta { padding: 36px 28px 48px; }
    .profile-name {
      font-family: 'Oswald', sans-serif;
      font-size: clamp(2.4rem, 10vw, 3.4rem);
      font-weight: 500; letter-spacing: 0.04em; line-height: 0.95;
      text-transform: uppercase;
    }
    .profile-title {
      margin-top: 10px; font-size: 0.78rem; letter-spacing: 0.28em;
      text-transform: uppercase; color: #8a867c;
    }
    .profile-bio { margin-top: 22px; font-size: 1.02rem; line-height: 1.7; color: #c4c0b6; }
    .social-grid { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 8px; }
    .social-link {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 14px; text-decoration: none; color: #e8e4dc;
      border: 1px solid #2a2a2a; font-family: 'Oswald', sans-serif;
      font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase;
    }
    .social-link:hover { background: #e8e4dc; color: #000; }
    .no-social { color: #555; }
  </style>
</head>
<body>
  <div class="stage">
    <div class="still"><%- include('partials/avatar') %></div>
    <div class="meta">
      <h1 class="profile-name"><%= card.name %></h1>
      <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
      <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
      <%- include('partials/social') %>
    </div>
  </div>
</body>
</html>
