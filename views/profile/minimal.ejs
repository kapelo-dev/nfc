<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Syne', sans-serif;
      background: #fbfbfb;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 48px 24px;
      color: #111;
    }
    .wrap { width: min(380px, 100%); }
    .profile-photo, .default-avatar {
      width: 72px; height: 72px; border-radius: 8px;
      object-fit: cover; margin-bottom: 36px;
    }
    .profile-photo { display: block; }
    .default-avatar { background: #eee; display: grid; place-items: center; }
    .default-avatar i { color: #bbb; font-size: 22px; }
    .profile-name {
      font-size: clamp(2.2rem, 8vw, 3.2rem);
      font-weight: 700; letter-spacing: -0.05em; line-height: 0.95;
    }
    .profile-title { margin-top: 12px; font-size: 0.95rem; font-weight: 500; color: #737373; }
    .profile-bio { margin-top: 28px; font-size: 1rem; line-height: 1.65; color: #404040; font-weight: 500; }
    .social-grid { margin-top: 48px; display: flex; flex-direction: column; gap: 0; }
    .social-link {
      display: flex; align-items: center; gap: 16px;
      padding: 14px 0; text-decoration: none; color: #111;
      border-top: 1px solid #ececec; font-weight: 600; font-size: 0.95rem;
    }
    .social-grid .social-link:last-child { border-bottom: 1px solid #ececec; }
    .social-link i { font-size: 0.85rem; color: #a3a3a3; width: 18px; }
    .social-link:hover { opacity: 0.45; }
    .no-social { margin-top: 40px; color: #a3a3a3; }
  </style>
</head>
<body>
  <div class="wrap">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
  </div>
</body>
</html>
