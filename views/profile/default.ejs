<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root { --accent: <%= theme.color %>; --r: <%= theme.rgb.r %>; --g: <%= theme.rgb.g %>; --b: <%= theme.rgb.b %>; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Instrument Sans', system-ui, sans-serif;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 32px 16px;
      color: #0f172a;
      background:
        radial-gradient(1200px 600px at 10% -10%, rgba(var(--r),var(--g),var(--b),0.28), transparent 55%),
        radial-gradient(900px 500px at 110% 110%, rgba(var(--r),var(--g),var(--b),0.18), transparent 50%),
        #f4f6f8;
    }
    .card {
      width: min(420px, 100%);
      background: #fff;
      border: 1px solid rgba(15,23,42,0.06);
      border-radius: 24px;
      overflow: hidden;
      animation: rise 0.7s cubic-bezier(0.16,1,0.3,1);
    }
    @keyframes rise {
      from { opacity: 0; transform: translateY(18px) scale(0.98); }
      to { opacity: 1; transform: none; }
    }
    .cover {
      height: 92px;
      background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 70%, #0f172a));
    }
    .inner { padding: 0 28px 32px; text-align: center; }
    .profile-photo, .default-avatar {
      width: 96px; height: 96px; border-radius: 50%;
      object-fit: cover; display: block;
      margin: -48px auto 18px;
      border: 3px solid #fff;
      background: #eef2f6;
    }
    .default-avatar { display: grid; place-items: center; }
    .default-avatar i { font-size: 32px; color: var(--accent); }
    .profile-name { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.03em; }
    .profile-title {
      margin-top: 6px; font-size: 0.8rem; font-weight: 500;
      letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);
    }
    .profile-bio { margin: 16px auto 0; max-width: 34ch; font-size: 0.92rem; line-height: 1.6; color: #475569; }
    .social-grid { margin-top: 28px; display: grid; gap: 8px; }
    .social-link {
      display: flex; align-items: center; gap: 12px;
      padding: 13px 16px; border-radius: 12px;
      text-decoration: none; color: #0f172a;
      background: #f8fafc; border: 1px solid #eef2f6;
      font-size: 0.9rem; font-weight: 600;
      transition: 0.2s ease;
    }
    .social-link span { flex: 1; text-align: left; }
    .social-link i { width: 18px; text-align: center; color: var(--accent); }
    .social-link:hover { border-color: var(--accent); background: #fff; transform: translateX(3px); }
    .no-social { margin-top: 24px; color: #94a3b8; font-size: 0.85rem; }
  </style>
</head>
<body>
  <article class="card">
    <div class="cover"></div>
    <div class="inner">
      <%- include('partials/avatar') %>
      <h1 class="profile-name"><%= card.name %></h1>
      <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
      <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
      <%- include('partials/social') %>
    </div>
  </article>
</body>
</html>
