<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'IBM Plex Mono', monospace;
      background: #07070c;
      background-image:
        linear-gradient(rgba(34,211,238,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(34,211,238,0.04) 1px, transparent 1px);
      background-size: 48px 48px;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 24px;
      color: #e2e8f0;
    }
    .panel {
      width: min(420px, 100%);
      padding: 40px 28px;
      background: rgba(7,7,12,0.86);
      border: 1px solid rgba(34,211,238,0.28);
      box-shadow: 0 0 0 1px rgba(255,0,180,0.08), 0 24px 80px rgba(0,0,0,0.55);
    }
    .profile-photo, .default-avatar {
      width: 88px; height: 88px; object-fit: cover;
      border-radius: 4px; margin: 0 auto 22px;
      border: 1px solid #22d3ee;
    }
    .profile-photo { display: block; }
    .default-avatar { background: #0c1220; display: grid; place-items: center; }
    .default-avatar i { color: #22d3ee; }
    .profile-name {
      font-family: 'Syne', sans-serif;
      font-size: 1.7rem; font-weight: 800; text-align: center;
      color: #f8fafc; letter-spacing: -0.03em;
    }
    .profile-title {
      text-align: center; margin-top: 8px; font-size: 0.7rem;
      letter-spacing: 0.18em; text-transform: uppercase; color: #22d3ee;
    }
    .profile-bio {
      text-align: center; margin: 18px auto 0; max-width: 38ch;
      font-size: 0.78rem; line-height: 1.7; color: #94a3b8;
    }
    .social-grid { margin-top: 28px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .social-link {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      padding: 12px 8px; text-decoration: none; color: #e2e8f0;
      border: 1px solid rgba(34,211,238,0.25); font-size: 0.68rem;
      letter-spacing: 0.08em; text-transform: uppercase; transition: 0.2s;
    }
    .social-link:hover {
      border-color: #f0abfc; color: #f0abfc;
      box-shadow: inset 0 0 20px rgba(240,171,252,0.08);
    }
    .no-social { text-align: center; margin-top: 20px; color: #475569; font-size: 0.75rem; }
  </style>
</head>
<body>
  <article class="panel">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
  </article>
</body>
</html>
