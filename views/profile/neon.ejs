<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root { --accent: <%= theme.color %>; --r: <%= theme.rgb.r %>; --g: <%= theme.rgb.g %>; --b: <%= theme.rgb.b %>; --accent2: #ff2fd0; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Rajdhani', sans-serif;
      background: #050510;
      background-image:
        radial-gradient(480px 340px at 15% -8%, rgba(var(--r),var(--g),var(--b),0.22), transparent 60%),
        radial-gradient(420px 320px at 100% 20%, rgba(255,47,208,0.14), transparent 55%);
      display: flex; justify-content: center; color: #eaf6ff;
    }
    .wrap { width: min(390px, 100%); padding: 56px 28px 48px; display: flex; flex-direction: column; align-items: center; text-align: center; }
    .profile-photo, .default-avatar {
      width: 104px; height: 104px; border-radius: 50%; object-fit: cover;
      border: 2px solid var(--accent); background: #0c0a18; flex-shrink: 0;
      box-shadow: 0 0 0 4px rgba(var(--r),var(--g),var(--b),0.12), 0 0 26px -4px rgba(var(--r),var(--g),var(--b),0.65);
    }
    .default-avatar { display: grid; place-items: center; }
    .default-avatar i { font-size: 34px; color: var(--accent); text-shadow: 0 0 14px rgba(var(--r),var(--g),var(--b),0.8); }
    .profile-name {
      margin: 26px 0 0; font-family: 'Orbitron', sans-serif; font-weight: 700; font-size: 22px;
      letter-spacing: 0.04em; text-transform: uppercase; color: #fff;
      text-shadow: 0 0 12px rgba(var(--r),var(--g),var(--b),0.85), 0 0 28px rgba(var(--r),var(--g),var(--b),0.45);
    }
    .profile-title {
      margin-top: 14px; display: inline-block; padding: 6px 16px; border-radius: 999px;
      border: 1px solid var(--accent2); color: var(--accent2); font-size: 11px; font-weight: 600;
      letter-spacing: 0.14em; text-transform: uppercase;
      box-shadow: 0 0 16px -2px rgba(255,47,208,0.55);
    }
    .profile-bio { margin: 22px 0 0; font-size: 15px; line-height: 1.6; color: #a8b6cc; max-width: 30ch; font-weight: 500; }
    .social-grid { margin-top: 36px; width: 100%; display: flex; flex-direction: column; gap: 12px; }
    .social-link {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      padding: 13px; border-radius: 12px; text-decoration: none; color: #eaf6ff;
      background: rgba(255,255,255,0.03); border: 1px solid rgba(var(--r),var(--g),var(--b),0.4);
      font-size: 14.5px; font-weight: 600; letter-spacing: 0.02em;
      transition: box-shadow 0.2s, border-color 0.2s, transform 0.15s;
    }
    .social-link i { color: var(--accent); text-shadow: 0 0 10px rgba(var(--r),var(--g),var(--b),0.8); }
    .social-link:hover { border-color: var(--accent); box-shadow: 0 0 22px -4px rgba(var(--r),var(--g),var(--b),0.75); transform: translateY(-1px); }
    .social-link-pending { cursor: default; opacity: 0.8; }
    .social-link-pending:hover { transform: none; box-shadow: none; }
    .social-link-pending em { font-style: normal; font-weight: 400; opacity: 0.65; }
    .social-link i.has-photo { display: inline-block; width: 20px; height: 20px; border-radius: 50%; background-size: cover; background-position: center; color: transparent; text-shadow: none; }
    .no-social { margin-top: 24px; color: #6b7a94; font-size: 0.85rem; }
    .footer-note { margin-top: 40px; font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase; color: #4a5670; }
  </style>
</head>
<body>
  <div class="wrap">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
    <p class="footer-note">Carte K_Pass</p>
  </div>
</body>
</html>
