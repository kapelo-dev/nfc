<%
  function httpsOrHandle(value, prefix, transform) {
    if (!value) return '';
    if (/^https:\/\//i.test(value)) return value;
    const handle = transform ? transform(value) : value;
    return prefix + encodeURIComponent(handle);
  }
  const items = [];
  if (card.snapchat) {
    items.push({
      cls: 'snapchat', icon: 'fab fa-snapchat', label: 'Snapchat',
      href: httpsOrHandle(card.snapchat, 'https://snapchat.com/add/')
    });
  }
  if (card.tiktok) {
    items.push({
      cls: 'tiktok', icon: 'fab fa-tiktok', label: 'TikTok',
      href: httpsOrHandle(card.tiktok, 'https://tiktok.com/@', function (v) { return v.replace(/^@/, ''); })
    });
  }
  if (card.whatsapp) {
    items.push({
      cls: 'whatsapp', icon: 'fab fa-whatsapp', label: 'WhatsApp',
      href: /^https:\/\//i.test(card.whatsapp)
        ? card.whatsapp
        : 'https://wa.me/' + String(card.whatsapp).replace(/[^0-9]/g, '')
    });
  }
  if (card.linkedin) {
    items.push({
      cls: 'linkedin', icon: 'fab fa-linkedin', label: 'LinkedIn',
      href: httpsOrHandle(card.linkedin, 'https://linkedin.com/in/')
    });
  }
  if (card.instagram) {
    items.push({
      cls: 'instagram', icon: 'fab fa-instagram', label: 'Instagram',
      href: httpsOrHandle(card.instagram, 'https://instagram.com/', function (v) { return v.replace(/^@/, ''); })
    });
  }
  if (card.facebook) {
    items.push({
      cls: 'facebook', icon: 'fab fa-facebook', label: 'Facebook',
      href: httpsOrHandle(card.facebook, 'https://facebook.com/')
    });
  }
%>
<% if (items.length) { %>
  <div class="social-grid">
    <% items.forEach(function(item) { %>
      <a href="<%= item.href %>" target="_blank" rel="noopener noreferrer" class="social-link <%= item.cls %>">
        <i class="<%= item.icon %>"></i>
        <span><%= item.label %></span>
      </a>
    <% }); %>
  </div>
<% } else { %>
  <div class="no-social">Aucun réseau social configuré</div>
<% } %>
