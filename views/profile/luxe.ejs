<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Outfit:wght@300;400&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', sans-serif;
      background: #e8e0d4;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 24px;
    }
    .frame {
      width: min(440px, 100%);
      padding: 8px;
      background: #c4a574;
    }
    .inner {
      background: #f3eee6;
      padding: 52px 36px 40px;
      text-align: center;
    }
    .mark {
      font-size: 0.62rem; letter-spacing: 0.42em; text-transform: uppercase;
      color: #c4a574; margin-bottom: 36px; font-weight: 400;
    }
    .profile-photo, .default-avatar {
      width: 104px; height: 104px; border-radius: 50%;
      object-fit: cover; margin: 0 auto 28px;
      outline: 1px solid #c4a574; outline-offset: 6px;
    }
    .profile-photo { display: block; }
    .default-avatar { background: #e8e0d4; display: grid; place-items: center; }
    .default-avatar i { color: #c4a574; font-size: 28px; }
    .profile-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.4rem; font-weight: 500; color: #1c1610;
    }
    .profile-title {
      font-style: italic; font-family: 'Cormorant Garamond', serif;
      font-size: 1.15rem; color: #8a7a64; margin-top: 8px;
    }
    .profile-bio {
      margin: 24px auto 0; max-width: 36ch;
      font-weight: 300; font-size: 0.92rem; line-height: 1.8; color: #5c5346;
    }
    .social-grid { margin-top: 36px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .social-link {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      padding: 12px 8px; text-decoration: none; color: #1c1610;
      border: 1px solid #c4a574; font-size: 0.72rem; letter-spacing: 0.12em;
      text-transform: uppercase; font-weight: 400;
      transition: 0.2s;
    }
    .social-link:hover { background: #1c1610; color: #f3eee6; border-color: #1c1610; }
    .social-link i { font-size: 0.8rem; }
    .no-social { margin-top: 28px; color: #a89b88; }
  </style>
</head>
<body>
  <div class="frame">
    <article class="inner">
      <p class="mark">Private card</p>
      <%- include('partials/avatar') %>
      <h1 class="profile-name"><%= card.name %></h1>
      <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
      <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
      <%- include('partials/social') %>
    </article>
  </div>
</body>
</html>
