<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,500&family=Karla:wght@400;500&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Karla', sans-serif;
      background: #f7f5f2;
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
    }
    .spread {
      max-width: 680px; width: 100%;
      display: grid; grid-template-columns: 1fr 1fr;
      background: #fff;
      min-height: 460px;
      box-shadow: 0 30px 80px rgba(0,0,0,0.08);
    }
    .photo-col {
      background: #111;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden;
    }
    .profile-photo {
      width: 100%; height: 100%; object-fit: cover; min-height: 320px;
      filter: contrast(1.05);
    }
    .default-avatar {
      width: 100%; height: 100%; min-height: 320px;
      display: flex; align-items: center; justify-content: center;
      background: #1a1a1a;
    }
    .default-avatar i { font-size: 64px; color: #444; }
    .copy {
      padding: 48px 36px;
      display: flex; flex-direction: column; justify-content: center;
    }
    .kicker { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: #999; margin-bottom: 12px; }
    .profile-name {
      font-family: 'Playfair Display', serif;
      font-size: 40px; font-weight: 700; line-height: 1.05; color: #111;
    }
    .profile-title {
      font-family: 'Playfair Display', serif;
      font-style: italic; font-size: 16px; color: #666; margin: 12px 0 20px;
    }
    .profile-bio { color: #444; line-height: 1.7; font-size: 14px; margin-bottom: 28px; }
    .social-grid { display: flex; flex-direction: column; gap: 8px; }
    .social-link {
      display: flex; align-items: center; gap: 10px;
      text-decoration: none; color: #111; font-size: 13px;
      border-bottom: 1px solid #eee; padding: 8px 0; font-weight: 500;
    }
    .social-link:hover { color: #888; }
    .no-social { color: #bbb; }
    .footer { margin-top: 24px; font-size: 10px; letter-spacing: 2px; color: #ccc; text-transform: uppercase; }
    @media (max-width: 640px) {
      .spread { grid-template-columns: 1fr; }
      .photo-col { min-height: 240px; }
    }
  </style>
</head>
<body>
  <div class="spread">
    <div class="photo-col">
      <%- include('partials/avatar') %>
    </div>
    <div class="copy">
      <p class="kicker">The profile</p>
      <h1 class="profile-name"><%= card.name %></h1>
      <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
      <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
      <%- include('partials/social') %>
      <p class="footer">Volume 01</p>
    </div>
  </div>
</body>
</html>
