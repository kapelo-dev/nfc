<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,400&family=Outfit:wght@400;500&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', sans-serif;
      background: #f3f1ec;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 24px;
      color: #171717;
    }
    .spread {
      width: min(680px, 100%);
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      background: #fff;
      min-height: 480px;
    }
    .photo-col { background: #111; overflow: hidden; }
    .profile-photo { width: 100%; height: 100%; min-height: 320px; object-fit: cover; display: block; }
    .default-avatar {
      width: 100%; height: 100%; min-height: 320px;
      display: grid; place-items: center; background: #1a1a1a;
    }
    .default-avatar i { font-size: 48px; color: #3f3f3f; }
    .copy { padding: 48px 36px; display: flex; flex-direction: column; justify-content: center; }
    .kicker { font-size: 0.65rem; letter-spacing: 0.28em; text-transform: uppercase; color: #a3a3a3; margin-bottom: 14px; }
    .profile-name {
      font-family: 'Newsreader', serif;
      font-size: clamp(2.2rem, 5vw, 3rem); font-weight: 500; line-height: 1.05;
    }
    .profile-title {
      font-family: 'Newsreader', serif; font-style: italic;
      font-size: 1.1rem; color: #737373; margin: 12px 0 20px;
    }
    .profile-bio { font-size: 0.92rem; line-height: 1.7; color: #404040; margin-bottom: 28px; }
    .social-grid { display: flex; flex-direction: column; }
    .social-link {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 0; text-decoration: none; color: #171717;
      border-bottom: 1px solid #eee; font-size: 0.85rem; font-weight: 500;
    }
    .social-link:hover { color: #737373; }
    .no-social { color: #a3a3a3; }
    @media (max-width: 640px) {
      .spread { grid-template-columns: 1fr; }
      .photo-col { height: 240px; }
      .copy { padding: 32px 24px 40px; }
    }
  </style>
</head>
<body>
  <article class="spread">
    <div class="photo-col"><%- include('partials/avatar') %></div>
    <div class="copy">
      <p class="kicker">Profile</p>
      <h1 class="profile-name"><%= card.name %></h1>
      <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
      <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
      <%- include('partials/social') %>
    </div>
  </article>
</body>
</html>
