<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Quicksand', sans-serif;
      background: linear-gradient(160deg, #fdf2f8 0%, #fce7f3 50%, #fbcfe8 100%);
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
    }
    .card {
      max-width: 440px; width: 100%;
      background: #fff;
      border-radius: 32px;
      padding: 40px 28px 28px;
      text-align: center;
      box-shadow: 0 20px 50px rgba(244, 114, 182, 0.25);
    }
    .profile-photo, .default-avatar {
      width: 118px; height: 118px; border-radius: 50%;
      object-fit: cover; margin: 0 auto 18px;
      border: 4px solid #fbcfe8;
    }
    .profile-photo { display: block; }
    .default-avatar { background: #fdf2f8; display: flex; align-items: center; justify-content: center; margin-left: auto; margin-right: auto; }
    .default-avatar i { font-size: 48px; color: #f472b6; }
    .profile-name { font-size: 26px; font-weight: 700; color: #831843; }
    .profile-title { color: #db2777; font-weight: 600; margin: 6px 0 14px; }
    .profile-bio { color: #9d174d; line-height: 1.7; font-size: 14px; margin-bottom: 26px; }
    .social-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .social-link {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      padding: 13px; border-radius: 999px; text-decoration: none;
      background: #fdf2f8; color: #9d174d; font-weight: 600; font-size: 13px;
      transition: 0.2s;
    }
    .social-link:hover { background: #f472b6; color: #fff; }
    .no-social { color: #f9a8d4; }
    .footer { margin-top: 22px; font-size: 12px; color: #f9a8d4; }
  </style>
</head>
<body>
  <div class="card">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
    <p class="footer">avec amour ♡</p>
  </div>
</body>
</html>
