<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,400&family=Outfit:wght@400;500&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', sans-serif;
      background: #f6efe9;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 24px;
      color: #3f2a32;
    }
    .card {
      width: min(420px, 100%);
      background: #fffaf6;
      border-radius: 28px;
      padding: 44px 28px 32px;
      text-align: center;
      border: 1px solid #eadfd6;
    }
    .profile-photo, .default-avatar {
      width: 108px; height: 108px; border-radius: 50%;
      object-fit: cover; margin: 0 auto 20px;
    }
    .profile-photo { display: block; }
    .default-avatar { background: #f3e6e0; display: grid; place-items: center; }
    .default-avatar i { color: #c48b96; font-size: 32px; }
    .profile-name {
      font-family: 'Fraunces', serif;
      font-size: 2rem; font-weight: 500; color: #4a2c35;
    }
    .profile-title { margin-top: 8px; font-size: 0.9rem; color: #c48b96; font-weight: 500; }
    .profile-bio {
      font-family: 'Fraunces', serif; font-style: italic; font-weight: 400;
      margin: 18px auto 0; max-width: 34ch; line-height: 1.7; color: #7a5b64;
    }
    .social-grid { margin-top: 28px; display: flex; flex-direction: column; gap: 8px; }
    .social-link {
      display: flex; align-items: center; gap: 12px;
      padding: 13px 16px; border-radius: 999px;
      text-decoration: none; color: #4a2c35;
      background: #f6efe9; font-size: 0.88rem; font-weight: 500;
      transition: 0.2s;
    }
    .social-link span { flex: 1; text-align: left; }
    .social-link i { width: 18px; color: #c48b96; }
    .social-link:hover { background: #4a2c35; color: #fffaf6; }
    .social-link:hover i { color: #fffaf6; }
    .no-social { margin-top: 20px; color: #c4b0b4; }
  </style>
</head>
<body>
  <article class="card">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
  </article>
</body>
</html>
