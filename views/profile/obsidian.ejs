<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Outfit:wght@400;500&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', sans-serif;
      background: #0d0c0a;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 24px;
      color: #f3efe6;
    }
    .card {
      width: min(440px, 100%);
      padding: 48px 32px;
      background: linear-gradient(180deg, #161410, #0f0e0c);
      border: 1px solid #2a261f;
    }
    .profile-photo, .default-avatar {
      width: 92px; height: 92px; border-radius: 50%;
      object-fit: cover; margin: 0 auto 28px;
      border: 1px solid #c4a574;
    }
    .profile-photo { display: block; }
    .default-avatar { background: #1c1914; display: grid; place-items: center; }
    .default-avatar i { color: #c4a574; }
    .profile-name {
      font-family: 'Fraunces', serif;
      font-size: 2.1rem; font-weight: 500; text-align: center;
      letter-spacing: -0.02em;
    }
    .profile-title {
      text-align: center; margin-top: 10px;
      font-size: 0.68rem; letter-spacing: 0.32em; text-transform: uppercase; color: #c4a574;
    }
    .profile-bio {
      text-align: center; margin: 22px auto 0; max-width: 38ch;
      font-size: 0.9rem; line-height: 1.75; color: #b7ae9e;
    }
    .social-grid { margin-top: 36px; display: flex; flex-direction: column; gap: 8px; }
    .social-link {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      padding: 13px; text-decoration: none; color: #f3efe6;
      border: 1px solid #c4a574; font-size: 0.78rem; letter-spacing: 0.14em;
      text-transform: uppercase; font-weight: 500; transition: 0.2s;
    }
    .social-link:hover { background: #c4a574; color: #0d0c0a; }
    .no-social { text-align: center; margin-top: 24px; color: #5c564c; }
  </style>
</head>
<body>
  <article class="card">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
  </article>
</body>
</html>
