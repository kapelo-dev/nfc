<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Syncopate:wght@700&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', sans-serif;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 24px;
      background:
        radial-gradient(circle at 20% 20%, #67e8f9 0, transparent 35%),
        radial-gradient(circle at 80% 80%, #f0abfc 0, transparent 40%),
        linear-gradient(160deg, #e9d5ff, #a5f3fc);
    }
    .card {
      width: min(400px, 100%);
      padding: 36px 24px;
      text-align: center;
      background: linear-gradient(145deg, rgba(255,255,255,0.72), rgba(255,255,255,0.28));
      border: 1px solid rgba(255,255,255,0.8);
      border-radius: 8px 28px 8px 28px;
      backdrop-filter: blur(10px);
    }
    .profile-photo, .default-avatar {
      width: 96px; height: 96px; border-radius: 18px;
      object-fit: cover; margin: 0 auto 18px;
      transform: rotate(-3deg);
      border: 2px solid #fff;
    }
    .profile-photo { display: block; }
    .default-avatar { background: #e879f9; display: grid; place-items: center; }
    .default-avatar i { color: #fff; }
    .profile-name {
      font-family: 'Syncopate', sans-serif;
      font-size: 1.05rem; line-height: 1.3;
      background: linear-gradient(90deg, #831843, #0e7490);
      -webkit-background-clip: text; background-clip: text;
      color: transparent;
    }
    .profile-title { margin-top: 10px; font-size: 0.78rem; letter-spacing: 0.18em; text-transform: uppercase; color: #6b21a8; font-weight: 600; }
    .profile-bio { margin: 16px auto 0; max-width: 34ch; font-size: 0.9rem; line-height: 1.6; color: #581c87; }
    .social-grid { margin-top: 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .social-link {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      padding: 12px 8px; border-radius: 12px; text-decoration: none;
      background: #fff; color: #831843; font-weight: 600; font-size: 0.75rem;
      border: 1px solid #f5d0fe; transition: 0.15s;
    }
    .social-link:hover { background: #22d3ee; color: #fff; border-color: #fff; }
    .no-social { margin-top: 16px; color: #a21caf; }
  </style>
</head>
<body>
  <article class="card">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
  </article>
</body>
</html>
