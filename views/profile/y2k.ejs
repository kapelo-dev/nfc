<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Audiowide&family=Outfit:wght@500;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', sans-serif;
      background: linear-gradient(160deg, #f0abfc 0%, #67e8f9 45%, #c084fc 100%);
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
    }
    .stars { position: fixed; inset: 0; pointer-events: none; font-size: 18px; }
    .stars span { position: absolute; animation: tw 2s ease-in-out infinite; }
    .stars span:nth-child(1) { top: 12%; left: 10%; }
    .stars span:nth-child(2) { top: 20%; right: 14%; animation-delay: 0.4s; }
    .stars span:nth-child(3) { bottom: 18%; left: 18%; animation-delay: 0.8s; }
    .stars span:nth-child(4) { bottom: 12%; right: 10%; animation-delay: 0.2s; }
    @keyframes tw { 50% { opacity: 0.3; transform: scale(1.3); } }
    .card {
      max-width: 420px; width: 100%;
      background: rgba(255,255,255,0.55);
      border: 3px solid #fff;
      border-radius: 20px;
      padding: 36px 24px;
      text-align: center;
      box-shadow: 0 0 0 4px #22d3ee, 8px 8px 0 #f0abfc;
    }
    .profile-photo, .default-avatar {
      width: 108px; height: 108px; border-radius: 20px;
      object-fit: cover; margin: 0 auto 16px;
      border: 3px solid #fff;
      transform: rotate(-4deg);
    }
    .profile-photo { display: block; }
    .default-avatar { background: #e879f9; display: flex; align-items: center; justify-content: center; margin-left: auto; margin-right: auto; }
    .default-avatar i { font-size: 42px; color: #fff; }
    .profile-name {
      font-family: 'Pacifico', cursive;
      font-size: 30px; color: #831843;
      background: linear-gradient(90deg, #ec4899, #22d3ee);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .profile-title {
      font-family: 'Audiowide', sans-serif;
      font-size: 11px; letter-spacing: 2px; color: #7c3aed; margin: 8px 0 14px;
    }
    .profile-bio { color: #6b21a8; font-weight: 500; line-height: 1.6; margin-bottom: 22px; font-size: 14px; }
    .social-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .social-link {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      padding: 12px; border-radius: 12px; text-decoration: none;
      background: #fff; color: #831843; font-weight: 700; font-size: 12px;
      border: 2px solid #f0abfc; transition: 0.15s;
    }
    .social-link:hover { background: #22d3ee; color: #fff; border-color: #fff; }
    .no-social { color: #c026d3; }
    .footer { margin-top: 18px; font-family: 'Audiowide', sans-serif; font-size: 10px; color: #7c3aed; }
  </style>
</head>
<body>
  <div class="stars"><span>★</span><span>✦</span><span>★</span><span>✧</span></div>
  <div class="card">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
    <p class="footer">Y2K FOREVER</p>
  </div>
</body>
</html>
