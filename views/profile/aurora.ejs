<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Syne', sans-serif;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 24px;
      color: #0f172a;
      background: linear-gradient(120deg, #c4b5fd, #67e8f9, #f9a8d4, #a5b4fc);
      background-size: 280% 280%;
      animation: shift 16s ease infinite;
    }
    @keyframes shift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    .card {
      width: min(400px, 100%);
      background: rgba(255,255,255,0.78);
      border-radius: 28px;
      padding: 40px 28px;
      text-align: center;
      border: 1px solid rgba(255,255,255,0.9);
    }
    .profile-photo, .default-avatar {
      width: 104px; height: 104px; border-radius: 50%;
      object-fit: cover; margin: 0 auto 18px;
    }
    .profile-photo { display: block; }
    .default-avatar { background: #ede9fe; display: grid; place-items: center; }
    .default-avatar i { color: #7c3aed; }
    .profile-name { font-size: 1.7rem; font-weight: 800; letter-spacing: -0.04em; }
    .profile-title { margin-top: 6px; font-weight: 600; color: #6d28d9; }
    .profile-bio { margin: 14px auto 0; max-width: 36ch; font-size: 0.9rem; line-height: 1.6; font-weight: 600; color: #334155; }
    .social-grid { margin-top: 26px; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
    .social-link {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 10px 16px; border-radius: 999px; text-decoration: none;
      background: #0f172a; color: #fff; font-weight: 700; font-size: 0.78rem;
      transition: 0.2s;
    }
    .social-link:hover { transform: translateY(-2px); }
    .no-social { margin-top: 20px; }
  </style>
</head>
<body>
  <article class="card">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
  </article>
</body>
</html>
