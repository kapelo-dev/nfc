<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Syne', sans-serif;
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
      background: linear-gradient(120deg, #c084fc, #67e8f9, #f9a8d4, #a78bfa);
      background-size: 300% 300%;
      animation: aurora 12s ease infinite;
      color: #fff;
    }
    @keyframes aurora {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    .card {
      max-width: 440px; width: 100%;
      text-align: center;
      background: rgba(255,255,255,0.12);
      border-radius: 32px;
      padding: 40px 28px;
      border: 1px solid rgba(255,255,255,0.4);
    }
    .profile-photo, .default-avatar {
      width: 120px; height: 120px; border-radius: 50%;
      object-fit: cover; margin: 0 auto 18px;
      box-shadow: 0 0 0 4px rgba(255,255,255,0.5), 0 10px 30px rgba(0,0,0,0.15);
    }
    .profile-photo { display: block; }
    .default-avatar { background: rgba(255,255,255,0.25); display: flex; align-items: center; justify-content: center; margin-left: auto; margin-right: auto; }
    .default-avatar i { font-size: 48px; }
    .profile-name { font-size: 28px; font-weight: 800; text-shadow: 0 2px 16px rgba(0,0,0,0.15); }
    .profile-title { font-weight: 600; opacity: 0.95; margin: 8px 0 14px; }
    .profile-bio { font-weight: 500; line-height: 1.7; margin-bottom: 28px; font-size: 14px; }
    .social-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
    .social-link {
      display: flex; align-items: center; gap: 8px;
      padding: 12px 18px; border-radius: 999px; text-decoration: none; color: #4c1d95;
      background: #fff; font-weight: 700; font-size: 13px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.1); transition: 0.2s;
    }
    .social-link:hover { transform: translateY(-3px); }
    .no-social { opacity: 0.85; }
    .footer { margin-top: 24px; font-size: 12px; font-weight: 600; opacity: 0.8; }
  </style>
</head>
<body>
  <div class="card">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
    <p class="footer">✦ aurora</p>
  </div>
</body>
</html>
