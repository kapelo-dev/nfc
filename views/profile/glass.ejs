<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', sans-serif;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 24px;
      overflow: hidden;
      background: #1b1340;
      color: #fff;
    }
    .orb {
      position: fixed; border-radius: 50%; filter: blur(72px); pointer-events: none;
    }
    .o1 { width: 340px; height: 340px; background: #7c3aed; top: -80px; left: -60px; opacity: 0.7; }
    .o2 { width: 300px; height: 300px; background: #06b6d4; bottom: -80px; right: -40px; opacity: 0.55; }
    .o3 { width: 220px; height: 220px; background: #f472b6; top: 40%; left: 40%; opacity: 0.35; }
    .card {
      position: relative; z-index: 1;
      width: min(400px, 100%);
      padding: 40px 28px;
      text-align: center;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.28);
      border-radius: 28px;
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
    }
    .profile-photo, .default-avatar {
      width: 96px; height: 96px; border-radius: 50%;
      object-fit: cover; margin: 0 auto 18px;
      border: 2px solid rgba(255,255,255,0.55);
    }
    .profile-photo { display: block; }
    .default-avatar { background: rgba(255,255,255,0.12); display: grid; place-items: center; }
    .profile-name { font-size: 1.55rem; font-weight: 700; letter-spacing: -0.03em; }
    .profile-title { margin-top: 6px; opacity: 0.85; font-weight: 500; }
    .profile-bio { margin: 16px auto 0; max-width: 36ch; font-size: 0.9rem; line-height: 1.6; opacity: 0.82; }
    .social-grid { margin-top: 26px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .social-link {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      padding: 12px 8px; border-radius: 14px; text-decoration: none; color: #fff;
      background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.22);
      font-weight: 600; font-size: 0.8rem; transition: 0.2s;
    }
    .social-link:hover { background: rgba(255,255,255,0.22); }
    .no-social { margin-top: 20px; opacity: 0.7; }
  </style>
</head>
<body>
  <div class="orb o1"></div><div class="orb o2"></div><div class="orb o3"></div>
  <article class="card">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
  </article>
</body>
</html>
