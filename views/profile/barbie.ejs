<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.name %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Archivo', sans-serif;
      background: #f4a6c1;
      min-height: 100vh;
      display: grid; place-items: center;
      padding: 24px;
    }
    .card {
      width: min(400px, 100%);
      background: #fff;
      padding: 36px 24px 24px;
      border: 3px solid #111;
    }
    .profile-photo, .default-avatar {
      width: 88px; height: 88px; border-radius: 0;
      object-fit: cover; margin: 0 auto 20px;
      border: 3px solid #111;
    }
    .profile-photo { display: block; }
    .default-avatar { background: #fce7f3; display: grid; place-items: center; }
    .default-avatar i { color: #111; }
    .profile-name {
      text-align: center; font-size: 1.8rem; font-weight: 800;
      letter-spacing: -0.04em; text-transform: uppercase;
    }
    .profile-title { text-align: center; margin-top: 6px; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #db2777; }
    .profile-bio { text-align: center; margin: 16px auto 0; font-size: 0.9rem; line-height: 1.55; font-weight: 500; }
    .social-grid { margin-top: 24px; display: flex; flex-direction: column; gap: 8px; }
    .social-link {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      padding: 14px; text-decoration: none; color: #fff;
      background: #111; font-weight: 800; font-size: 0.82rem;
      letter-spacing: 0.08em; text-transform: uppercase;
      border: 3px solid #111; transition: 0.15s;
    }
    .social-link:hover { background: #db2777; }
    .no-social { text-align: center; margin-top: 16px; font-weight: 700; }
  </style>
</head>
<body>
  <article class="card">
    <%- include('partials/avatar') %>
    <h1 class="profile-name"><%= card.name %></h1>
    <% if (card.title) { %><p class="profile-title"><%= card.title %></p><% } %>
    <% if (card.bio) { %><p class="profile-bio"><%= card.bio %></p><% } %>
    <%- include('partials/social') %>
  </article>
</body>
</html>
