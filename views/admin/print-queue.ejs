<%- include('partials/shell-open', { title: 'À imprimer', active: 'print-queue', extraHead: '<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alex+Brush&display=swap"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">' }) %>

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl font-semibold text-mono leading-none mb-1">Cartes à imprimer</h1>
    <p class="text-sm text-secondary-foreground">Cartes actives qui n'ont pas encore été envoyées à l'impression</p>
  </div>
</div>

<div class="kt-card">
  <div class="kt-card-header">
    <h3 class="kt-card-title">En attente d'impression (<%= cards.length %>)</h3>
  </div>
  <div class="kt-card-content p-0">
    <%- include('partials/print-table', { cards, templateNames, emptyMessage: 'Toutes les cartes actives ont déjà été envoyées à l\'impression.' }) %>
  </div>
</div>

<%- include('partials/shell-close') %>
