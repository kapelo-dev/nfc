<!DOCTYPE html>
<html class="h-full" lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Connexion Admin - NFC Card Manager</title>
  <link rel="stylesheet" href="/metronic/vendors/keenicons/styles.bundle.css">
  <link rel="stylesheet" href="/metronic/css/styles.css">
</head>
<body class="antialiased flex h-full text-base text-foreground bg-background">
  <div class="flex items-center justify-center grow bg-accent/40 p-4">
    <div class="kt-card max-w-[400px] w-full">
      <div class="kt-card-content flex flex-col gap-5 p-10">
        <div class="text-center mb-1">
          <div class="flex justify-center mb-3">
            <span class="flex items-center justify-center size-12 rounded-xl bg-primary/10 text-primary">
              <i class="ki-filled ki-scan-barcode text-2xl"></i>
            </span>
          </div>
          <h3 class="text-lg font-semibold text-mono leading-none mb-2.5">Connexion Admin</h3>
          <p class="text-sm text-secondary-foreground">NFC Card Manager</p>
        </div>

        <% if (error) { %>
          <div class="flex items-center gap-2 rounded-lg border border-destructive/20 bg-destructive/5 text-destructive text-sm px-3 py-2.5">
            <i class="ki-filled ki-information-2 text-base shrink-0"></i>
            <span><%= error %></span>
          </div>
        <% } %>

        <form method="POST" action="/admin/login" class="flex flex-col gap-4">
          <%- include('partials/csrf') %>
          <div class="flex flex-col gap-1">
            <label class="kt-form-label font-normal text-mono" for="username">Nom d'utilisateur</label>
            <input class="kt-input" id="username" name="username" type="text" required autofocus>
          </div>
          <div class="flex flex-col gap-1">
            <label class="kt-form-label font-normal text-mono" for="password">Mot de passe</label>
            <div class="kt-input" data-kt-toggle-password="true">
              <input id="password" name="password" type="password" required>
              <button class="kt-btn kt-btn-sm kt-btn-ghost kt-btn-icon bg-transparent! -me-1.5" data-kt-toggle-password-trigger="true" type="button">
                <span class="kt-toggle-password-active:hidden"><i class="ki-filled ki-eye text-muted-foreground"></i></span>
                <span class="hidden kt-toggle-password-active:block"><i class="ki-filled ki-eye-slash text-muted-foreground"></i></span>
              </button>
            </div>
          </div>
          <button class="kt-btn kt-btn-primary flex justify-center grow" type="submit">Se connecter</button>
        </form>
      </div>
    </div>
  </div>
  <script src="/metronic/js/ktui.min.js"></script>
</body>
</html>
