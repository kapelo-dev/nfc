<%- include('partials/shell-open', { title: (card ? 'Modifier' : 'Nouvelle') + ' carte', active: 'cards', extraHead: '<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alex+Brush&display=swap">' }) %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl font-semibold text-mono leading-none mb-1"><%= card ? 'Modifier la carte' : 'Créer une nouvelle carte' %></h1>
    <p class="text-sm text-secondary-foreground">Renseignez les informations qui apparaîtront sur le profil public</p>
  </div>
  <a class="kt-btn kt-btn-outline" href="/admin/dashboard">
    <i class="ki-filled ki-left"></i>
    Retour
  </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-5 items-start">
  <div class="kt-card">
    <div class="kt-card-content p-6 lg:p-8">
      <% if (error) { %>
        <div class="flex items-center gap-2 rounded-lg border border-destructive/20 bg-destructive/5 text-destructive text-sm px-3 py-2.5 mb-6">
          <i class="ki-filled ki-information-2 text-base shrink-0"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="<%= card ? `/admin/cards/${card.id}` : '/admin/cards' %>" id="card_form" enctype="multipart/form-data" class="flex flex-col gap-8">
        <%- include('partials/csrf') %>

        <% if (card && card.is_request) { %>
          <div class="rounded-lg border border-warning/30 bg-warning/5 p-4">
            <div class="flex items-center gap-2 mb-2">
              <span class="kt-badge kt-badge-sm kt-badge-warning kt-badge-outline">Demande en attente</span>
              <span class="text-xs text-secondary-foreground">Cette carte vient du formulaire public de commande</span>
            </div>
            <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-mono">
              <% if (card.contact_email) { %><span><i class="ki-filled ki-sms text-muted-foreground"></i> <%= card.contact_email %></span><% } %>
              <% if (card.contact_phone) { %><span><i class="ki-filled ki-phone text-muted-foreground"></i> <%= card.contact_phone %></span><% } %>
            </div>
          </div>
        <% } %>

        <div>
          <h3 class="text-sm font-semibold text-mono uppercase tracking-wide mb-4 pb-2.5 border-b border-border">
            Informations générales
          </h3>
          <div class="flex flex-col gap-4">
            <div class="flex flex-col gap-1">
              <label class="kt-form-label font-normal text-mono" for="name">Nom complet *</label>
              <input class="kt-input" id="name" name="name" type="text" value="<%= card ? card.name : '' %>" required>
            </div>

            <% if (card && card.card_id) { %>
              <div class="flex flex-col gap-1">
                <label class="kt-form-label font-normal text-mono">Lien de la carte</label>
                <input class="kt-input bg-muted text-muted-foreground cursor-not-allowed" type="text" value="/c/<%= card.card_id %>" readonly>
                <span class="text-xs text-secondary-foreground">Ce lien est généré automatiquement et ne peut pas être modifié</span>
              </div>
            <% } %>

            <div class="flex flex-col gap-1">
              <label class="kt-form-label font-normal text-mono flex items-center gap-1.5" for="contact_phone"><i class="fab fa-whatsapp" style="color:#25D366;"></i>Numéro WhatsApp à contacter</label>
              <input class="kt-input" id="contact_phone" name="contact_phone" type="tel" value="<%= card ? card.contact_phone : '' %>" placeholder="+228 90 00 00 00">
              <span class="text-xs text-secondary-foreground">Utilisé pour les notifications (paiement, activation de la carte) et pour lui envoyer un lien de paiement si besoin.</span>
            </div>

            <div class="flex flex-col gap-1">
              <label class="kt-form-label font-normal text-mono" for="title">Titre / Profession</label>
              <input class="kt-input" id="title" name="title" type="text" value="<%= card ? card.title : '' %>" placeholder="Ex: Développeur Web">
            </div>

            <div class="flex flex-col gap-1">
              <label class="kt-form-label font-normal text-mono" for="bio">Biographie</label>
              <textarea class="kt-textarea min-h-[100px]" id="bio" name="bio" placeholder="Quelques mots sur vous..."><%= card ? card.bio : '' %></textarea>
            </div>

            <div class="flex flex-col gap-1">
              <label class="kt-form-label font-normal text-mono" for="photo">Photo de profil</label>
              <% if (card && card.photo_url) { %>
                <div class="flex items-center gap-3 mb-1.5" data-photo-current>
                  <img src="<%= card.photo_url %>" alt="Photo actuelle" class="size-14 rounded-full object-cover border border-border">
                  <span class="text-xs text-secondary-foreground">Photo actuelle — choisissez un fichier pour la remplacer</span>
                  <button type="button" class="kt-btn kt-btn-sm kt-btn-icon kt-btn-outline kt-btn-destructive ms-auto shrink-0" data-remove-photo title="Retirer la photo">
                    <i class="ki-filled ki-trash"></i>
                  </button>
                </div>
              <% } %>
              <input class="kt-input" id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/gif,image/webp">
              <input type="hidden" name="existing_photo_url" value="<%= card ? card.photo_url : '' %>" data-existing-photo-url>
            </div>

            <div class="flex flex-col gap-1">
              <label class="kt-form-label font-normal text-mono" for="theme_color">Couleur du thème</label>
              <div class="flex items-center gap-2.5">
                <input class="h-10 w-14 rounded-md border border-input cursor-pointer shrink-0" id="theme_color" name="theme_color" type="color" value="<%= card && card.theme_color ? card.theme_color : '#42a5f5' %>">
                <input class="kt-input bg-muted text-muted-foreground" id="theme_color_text" type="text" value="<%= card && card.theme_color ? card.theme_color : '#42a5f5' %>" readonly>
              </div>
              <span class="text-xs text-secondary-foreground">Utilisée comme accent sur certains templates (Classique, Minuit…)</span>
            </div>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-mono uppercase tracking-wide mb-4 pb-2.5 border-b border-border">
            Template de la carte
          </h3>
          <% const selectedTpl = card && card.template ? card.template : 'default'; %>
          <div class="flex flex-col gap-5">
            <% categories.forEach(function(cat) { %>
              <div>
                <h4 class="text-xs font-semibold text-secondary-foreground uppercase tracking-wide mb-2.5"><%= cat.label %></h4>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                  <% templates.filter(function(t) { return t.category === cat.id; }).forEach(function(t) { %>
                    <label class="flex flex-col cursor-pointer">
                      <input class="peer sr-only" type="radio" name="template" value="<%= t.id %>" <%= selectedTpl === t.id ? 'checked' : '' %>>
                      <div class="flex flex-col items-center justify-center gap-1.5 h-[86px] rounded-lg border-2 border-border px-2.5 py-2 transition-all peer-checked:border-primary peer-checked:ring-2 peer-checked:ring-primary/20 hover:border-primary/50" style="background: <%= t.preview.bg %>; color: <%= t.preview.text %>;">
                        <div class="size-5 rounded-full opacity-85" style="background: <%= t.preview.card %>;"></div>
                        <div class="h-1 w-12 rounded-full opacity-70" style="background: currentColor;"></div>
                        <div class="h-1 w-8 rounded-full opacity-40" style="background: currentColor;"></div>
                      </div>
                      <span class="block text-center text-xs font-medium text-mono mt-1.5"><%= t.name %></span>
                    </label>
                  <% }); %>
                </div>
              </div>
            <% }); %>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-mono uppercase tracking-wide mb-4 pb-2.5 border-b border-border">
            Design physique de la carte
          </h3>
          <p class="text-xs text-secondary-foreground mb-4">Détermine quel fichier Canva utiliser pour la fabrication. Retournez une carte pour voir son verso.</p>
          <% const selectedPhysical = card && card.physical_style ? card.physical_style : physicalStyles[0].id; %>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            <% physicalStyles.forEach(function(s) { %>
              <label class="flex flex-col cursor-pointer">
                <input class="peer sr-only" type="radio" name="physical_style" value="<%= s.id %>" data-physical-option <%= selectedPhysical === s.id ? 'checked' : '' %>>
                <%- include('../partials/physical-card', { s, qrSrc: physicalQrCodes[s.id], qrCaption: 'Scanner pour<br>commander', previewName: true, previewTitle: true, displayName: '', displayTitle: '', photoUrl: card && card.photo_url ? card.photo_url : '' }) %>
                <span class="block text-center text-xs font-medium text-mono mt-1.5"><%= s.name %></span>
              </label>
            <% }); %>
            <label class="flex flex-col cursor-pointer">
              <input class="peer sr-only" type="radio" name="physical_style" value="custom" data-physical-option data-custom-design-radio <%= selectedPhysical === 'custom' ? 'checked' : '' %>>
              <%- include('../partials/custom-design-card', { imageSrc: card && card.custom_design_url ? card.custom_design_url : '', backImageSrc: card && card.custom_design_back_url ? card.custom_design_back_url : '', qrSrc: physicalQrCodes['custom'], qrCaption: 'Scanner pour<br>commander' }) %>
              <span class="block text-center text-xs font-medium text-mono mt-1.5">Design personnalisé</span>
            </label>
          </div>

          <div class="mt-4 <%= selectedPhysical === 'custom' ? 'flex' : 'hidden' %> flex-col gap-3" data-custom-design-upload>
            <div class="flex flex-col gap-1">
              <label class="kt-form-label font-normal text-mono" for="custom_design_photo">Votre visuel (recto de la carte)</label>
              <input class="kt-input" id="custom_design_photo" name="custom_design_photo" type="file" accept="image/jpeg,image/png,image/gif,image/webp" data-custom-design-input>
              <input type="hidden" name="existing_custom_design_url" value="<%= card && card.custom_design_url ? card.custom_design_url : '' %>">
              <span class="text-xs text-secondary-foreground">Format recommandé proche d'une carte de crédit (largeur ≈ 1,6× la hauteur), haute résolution.</span>
            </div>
            <div class="flex flex-col gap-1">
              <label class="kt-form-label font-normal text-mono" for="custom_design_back_photo">Votre visuel (verso de la carte, optionnel)</label>
              <input class="kt-input" id="custom_design_back_photo" name="custom_design_back_photo" type="file" accept="image/jpeg,image/png,image/gif,image/webp" data-custom-design-back-input>
              <input type="hidden" name="existing_custom_design_back_url" value="<%= card && card.custom_design_back_url ? card.custom_design_back_url : '' %>">
              <span class="text-xs text-secondary-foreground">Le QR code de commande sera superposé par-dessus. Sans visuel, le verso reste uni avec le QR code.</span>
            </div>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-mono uppercase tracking-wide mb-4 pb-2.5 border-b border-border">
            Réseaux sociaux
          </h3>
          <div class="flex flex-col gap-4">
            <div class="flex flex-col gap-1">
              <label class="kt-form-label font-normal text-mono flex items-center gap-1.5" for="snapchat"><i class="fab fa-snapchat text-[#FFFC00]"></i>Snapchat</label>
              <input class="kt-input" id="snapchat" name="snapchat" type="text" value="<%= card ? card.snapchat : '' %>" placeholder="Nom d'utilisateur ou lien">
              <% if (card && card.snapchat_photo) { %><a href="<%= card.snapchat_photo %>" target="_blank" rel="noopener" class="kt-link text-xs w-fit">Voir la photo du compte fournie</a><% } %>
            </div>
            <div class="flex flex-col gap-1">
              <label class="kt-form-label font-normal text-mono flex items-center gap-1.5" for="tiktok"><i class="fab fa-tiktok"></i>TikTok</label>
              <input class="kt-input" id="tiktok" name="tiktok" type="text" value="<%= card ? card.tiktok : '' %>" placeholder="@username ou lien">
              <% if (card && card.tiktok_photo) { %><a href="<%= card.tiktok_photo %>" target="_blank" rel="noopener" class="kt-link text-xs w-fit">Voir la photo du compte fournie</a><% } %>
            </div>
            <div class="flex flex-col gap-1">
              <label class="kt-form-label font-normal text-mono flex items-center gap-1.5" for="whatsapp"><i class="fab fa-whatsapp text-[#25D366]"></i>WhatsApp</label>
              <input class="kt-input" id="whatsapp" name="whatsapp" type="text" value="<%= card ? card.whatsapp : '' %>" placeholder="Numéro de téléphone ou lien">
              <% if (card && card.whatsapp_photo) { %><a href="<%= card.whatsapp_photo %>" target="_blank" rel="noopener" class="kt-link text-xs w-fit">Voir la photo du compte fournie</a><% } %>
            </div>
            <div class="flex flex-col gap-1">
              <label class="kt-form-label font-normal text-mono flex items-center gap-1.5" for="linkedin"><i class="fab fa-linkedin text-[#0077B5]"></i>LinkedIn</label>
              <input class="kt-input" id="linkedin" name="linkedin" type="text" value="<%= card ? card.linkedin : '' %>" placeholder="URL du profil">
              <% if (card && card.linkedin_photo) { %><a href="<%= card.linkedin_photo %>" target="_blank" rel="noopener" class="kt-link text-xs w-fit">Voir la photo du compte fournie</a><% } %>
            </div>
            <div class="flex flex-col gap-1">
              <label class="kt-form-label font-normal text-mono flex items-center gap-1.5" for="instagram"><i class="fab fa-instagram text-[#E4405F]"></i>Instagram</label>
              <input class="kt-input" id="instagram" name="instagram" type="text" value="<%= card ? card.instagram : '' %>" placeholder="@username ou lien">
              <% if (card && card.instagram_photo) { %><a href="<%= card.instagram_photo %>" target="_blank" rel="noopener" class="kt-link text-xs w-fit">Voir la photo du compte fournie</a><% } %>
            </div>
            <div class="flex flex-col gap-1">
              <label class="kt-form-label font-normal text-mono flex items-center gap-1.5" for="facebook"><i class="fab fa-facebook text-[#1877F2]"></i>Facebook</label>
              <input class="kt-input" id="facebook" name="facebook" type="text" value="<%= card ? card.facebook : '' %>" placeholder="URL du profil">
              <% if (card && card.facebook_photo) { %><a href="<%= card.facebook_photo %>" target="_blank" rel="noopener" class="kt-link text-xs w-fit">Voir la photo du compte fournie</a><% } %>
            </div>
          </div>
        </div>

        <% if (card) { %>
          <div>
            <h3 class="text-sm font-semibold text-mono uppercase tracking-wide mb-4 pb-2.5 border-b border-border">
              Paramètres
            </h3>
            <label class="kt-label">
              <input class="kt-checkbox" id="is_active" name="is_active" type="checkbox" value="1" <%= card && card.is_active ? 'checked' : '' %>>
              Carte active
            </label>
            <p class="text-xs text-secondary-foreground mt-1.5">Les cartes inactives ne sont pas accessibles publiquement</p>
          </div>
        <% } %>

        <div class="flex items-center gap-3 pt-6 border-t border-border">
          <button class="kt-btn kt-btn-primary grow justify-center" type="submit">
            <%= card ? 'Mettre à jour' : 'Créer la carte' %>
          </button>
          <a class="kt-btn kt-btn-outline grow justify-center" href="/admin/dashboard">Annuler</a>
        </div>
      </form>
    </div>
  </div>

  <aside class="kt-card lg:sticky lg:top-[86px]">
    <div class="kt-card-content p-5">
      <div class="flex items-center justify-between mb-3.5">
        <h3 class="text-sm font-semibold text-mono">Aperçu en direct</h3>
        <a class="kt-link text-xs" href="/admin/preview" id="preview-open" target="_blank" rel="noopener">Plein écran</a>
      </div>
      <div class="w-[240px] h-[480px] mx-auto rounded-[28px] border-[8px] border-mono overflow-hidden bg-mono shadow-lg">
        <iframe class="w-full h-full border-0 bg-background" id="tpl-preview-frame" title="Aperçu du template"></iframe>
      </div>
      <p class="text-xs text-secondary-foreground text-center mt-3">Cliquez un template pour le voir. L'aperçu suit aussi vos infos.</p>
    </div>
  </aside>
</div>
<script src="/js/admin-form.js"></script>

<%- include('partials/shell-close') %>
