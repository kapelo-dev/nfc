<%- include('partials/shell-open', { title: 'Tableau de bord', active: 'dashboard', extraHead: '<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alex+Brush&display=swap">' }) %>

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl font-semibold text-mono leading-none mb-1">Tableau de bord</h1>
    <p class="text-sm text-secondary-foreground">Gérez les cartes NFC et leurs profils publics</p>
  </div>
  <a class="kt-btn kt-btn-primary" href="/admin/cards/new">
    <i class="ki-filled ki-plus-circle"></i>
    Nouvelle carte
  </a>
</div>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-6">
  <div class="kt-card">
    <div class="kt-card-content flex items-center gap-4 p-5">
      <span class="flex items-center justify-center size-11 rounded-lg bg-primary/10 text-primary shrink-0">
        <i class="ki-filled ki-address-book text-xl"></i>
      </span>
      <div>
        <div class="text-xs text-secondary-foreground font-medium mb-0.5">Total des cartes</div>
        <div class="text-2xl font-semibold text-mono leading-none"><%= cards.length %></div>
      </div>
    </div>
  </div>
  <div class="kt-card">
    <div class="kt-card-content flex items-center gap-4 p-5">
      <span class="flex items-center justify-center size-11 rounded-lg bg-success/10 text-success shrink-0">
        <i class="ki-filled ki-check-circle text-xl"></i>
      </span>
      <div>
        <div class="text-xs text-secondary-foreground font-medium mb-0.5">Cartes actives</div>
        <div class="text-2xl font-semibold text-mono leading-none"><%= cards.filter(c => c.is_active).length %></div>
      </div>
    </div>
  </div>
  <div class="kt-card">
    <div class="kt-card-content flex items-center gap-4 p-5">
      <span class="flex items-center justify-center size-11 rounded-lg bg-destructive/5 text-destructive shrink-0">
        <i class="ki-filled ki-cross-circle text-xl"></i>
      </span>
      <div>
        <div class="text-xs text-secondary-foreground font-medium mb-0.5">Cartes inactives</div>
        <div class="text-2xl font-semibold text-mono leading-none"><%= cards.filter(c => !c.is_active).length %></div>
      </div>
    </div>
  </div>
</div>

<div class="kt-card">
  <div class="kt-card-header">
    <h3 class="kt-card-title">Toutes les cartes</h3>
  </div>
  <div class="kt-card-content p-0">
    <%- include('partials/print-table', { cards, templateNames }) %>
  </div>
</div>

<%- include('partials/shell-close') %>
