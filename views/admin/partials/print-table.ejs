<% if (cards.length === 0) { %>
  <div class="flex flex-col items-center text-center gap-3 py-16 px-6">
    <span class="flex items-center justify-center size-12 rounded-full bg-accent text-muted-foreground">
      <i class="ki-filled ki-address-book text-xl"></i>
    </span>
    <p class="text-sm text-secondary-foreground"><%= typeof emptyMessage !== 'undefined' ? emptyMessage : 'Aucune carte créée pour le moment' %></p>
    <% if (typeof emptyMessage === 'undefined') { %>
      <a class="kt-btn kt-btn-primary" href="/admin/cards/new">Créer votre première carte</a>
    <% } %>
  </div>
<% } else { %>
  <form method="POST" action="/admin/print" id="print_form" target="_blank">
    <%- include('csrf') %>
    <div class="flex flex-wrap items-center gap-3 px-5 py-3 border-b border-border bg-accent/30">
      <span class="text-xs text-secondary-foreground" data-print-count>0 carte(s) sélectionnée(s)</span>
      <button type="submit" class="kt-btn kt-btn-sm kt-btn-primary ms-auto" id="print_submit" disabled>
        <i class="ki-filled ki-printer"></i>
        Envoyer à l'impression
      </button>
    </div>
    <div class="overflow-x-auto">
      <table class="kt-table kt-table-border align-middle">
        <thead>
          <tr>
            <th class="w-[40px]">
              <input type="checkbox" class="kt-checkbox" data-print-select-all>
            </th>
            <th class="min-w-[160px]">Nom</th>
            <th class="min-w-[160px]">Lien de la carte</th>
            <th class="min-w-[140px]">Titre</th>
            <th class="min-w-[120px]">Template</th>
            <th class="min-w-[100px]">Statut</th>
            <th class="min-w-[130px]">Impression</th>
            <th class="min-w-[120px]">Créée le</th>
            <th class="min-w-[200px]">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% cards.forEach(card => { %>
            <tr>
              <td>
                <% if (card.is_active) { %>
                  <input type="checkbox" class="kt-checkbox" name="card_ids" value="<%= card.id %>" data-print-select>
                <% } %>
              </td>
              <td class="text-sm font-medium text-mono"><%= card.name %></td>
              <td>
                <a href="/c/<%= card.card_id %>" target="_blank" rel="noopener" class="kt-link text-sm">
                  /c/<%= card.card_id %>
                </a>
              </td>
              <td class="text-sm text-secondary-foreground"><%= card.title || '-' %></td>
              <td class="text-sm text-secondary-foreground"><%= templateNames[card.template] || card.template || 'Classique' %></td>
              <td>
                <% if (card.is_active) { %>
                  <span class="kt-badge kt-badge-sm kt-badge-success kt-badge-outline">Active</span>
                <% } else { %>
                  <span class="kt-badge kt-badge-sm kt-badge-destructive kt-badge-outline">Inactive</span>
                <% } %>
              </td>
              <td>
                <% if (card.print_status === 'sent') { %>
                  <span class="kt-badge kt-badge-sm kt-badge-info kt-badge-outline" title="<%= card.sent_to_print_at ? new Date(card.sent_to_print_at).toLocaleString('fr-FR') : '' %>">Envoyée</span>
                <% } else { %>
                  <span class="kt-badge kt-badge-sm kt-badge-outline">Non envoyée</span>
                <% } %>
              </td>
              <td class="text-sm text-secondary-foreground"><%= new Date(card.created_at).toLocaleDateString('fr-FR') %></td>
              <td>
                <div class="flex items-center gap-1.5">
                  <a href="/admin/cards/<%= card.id %>/edit" class="kt-btn kt-btn-sm kt-btn-icon kt-btn-outline" title="Modifier">
                    <i class="ki-filled ki-pencil"></i>
                  </a>
                  <button type="button" class="kt-btn kt-btn-sm kt-btn-icon kt-btn-outline" title="Voir recto/verso" data-kt-modal-toggle="#card_preview_modal" data-preview-trigger data-card-id="<%= card.id %>" data-card-name="<%= card.name %>">
                    <i class="ki-filled ki-eye"></i>
                  </button>
                  <button type="submit" formaction="/admin/cards/<%= card.id %>/delete" formtarget="_self" class="kt-btn kt-btn-sm kt-btn-icon kt-btn-outline kt-btn-destructive" title="Supprimer" data-confirm="Êtes-vous sûr de vouloir supprimer cette carte ?">
                    <i class="ki-filled ki-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </form>
<% } %>

<div class="kt-modal kt-modal-center" data-kt-modal="true" id="card_preview_modal">
  <div class="kt-modal-content max-w-[380px] w-full">
    <div class="kt-modal-header">
      <h3 class="kt-modal-title" data-preview-modal-title>Aperçu de la carte</h3>
      <button class="kt-modal-close" data-kt-modal-dismiss="true"><i class="ki-filled ki-cross"></i></button>
    </div>
    <div class="kt-modal-body flex flex-col items-center py-8" data-preview-modal-body></div>
  </div>
</div>
