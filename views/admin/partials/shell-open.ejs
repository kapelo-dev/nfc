<!DOCTYPE html>
<html class="h-full" lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - NFC Card Manager</title>
  <link rel="stylesheet" href="/metronic/vendors/keenicons/styles.bundle.css">
  <link rel="stylesheet" href="/metronic/css/styles.css">
  <% if (typeof extraHead !== 'undefined') { %><%- extraHead %><% } %>
</head>
<body class="antialiased h-full text-base text-foreground bg-background">
  <div class="flex h-full group/shell" data-sidebar-collapsed="false">
    <%
      const navItems = [
        { key: 'dashboard', href: '/admin/dashboard', icon: 'ki-element-11', label: 'Tableau de bord' },
        { key: 'requests', href: '/admin/requests', icon: 'ki-tablet-text-up', label: 'Demandes', count: typeof pendingRequestsCount !== 'undefined' ? pendingRequestsCount : 0, badgeClass: 'kt-badge-warning' },
        { key: 'print-queue', href: '/admin/print-queue', icon: 'ki-printer', label: 'À imprimer', count: typeof pendingPrintCount !== 'undefined' ? pendingPrintCount : 0, badgeClass: 'kt-badge-info' },
        { key: 'fulfillment', href: '/admin/fulfillment', icon: 'ki-package', label: 'Suivi fabrication' },
        { key: 'cards', href: '/admin/cards/new', icon: 'ki-plus-circle', label: 'Nouvelle carte' }
      ];
    %>
    <aside class="bg-background border-e border-e-border fixed inset-y-0 start-0 z-30 hidden w-[280px] lg:group-data-[sidebar-collapsed=true]/shell:w-16 lg:flex flex-col items-stretch shrink-0 [--kt-drawer-enable:true] lg:[--kt-drawer-enable:false]" data-kt-drawer="true" data-kt-drawer-class="kt-drawer kt-drawer-start top-0 bottom-0 bg-background" id="sidebar">
      <div class="flex items-center justify-between lg:group-data-[sidebar-collapsed=true]/shell:justify-center px-5 lg:group-data-[sidebar-collapsed=true]/shell:px-0 h-[70px] shrink-0 border-b border-border">
        <a class="flex items-center gap-2.5 text-mono font-semibold text-base leading-none" href="/admin/dashboard">
          <span class="flex items-center justify-center size-8 rounded-lg bg-primary/10 text-primary shrink-0">
            <i class="ki-filled ki-scan-barcode text-base"></i>
          </span>
          <span class="lg:group-data-[sidebar-collapsed=true]/shell:hidden">NFC Card Manager</span>
        </a>
        <button class="kt-btn kt-btn-icon kt-btn-ghost lg:hidden" data-kt-drawer-dismiss="true" type="button">
          <i class="ki-filled ki-cross"></i>
        </button>
      </div>
      <nav class="flex grow shrink-0 flex-col gap-1 py-4 px-3">
        <% navItems.forEach(function (item) { %>
          <a class="relative flex items-center gap-2.5 lg:group-data-[sidebar-collapsed=true]/shell:justify-center rounded-lg px-3 lg:group-data-[sidebar-collapsed=true]/shell:px-0 py-2.5 text-sm font-medium transition-colors <%= active === item.key ? 'bg-primary/10 text-primary' : 'text-foreground hover:bg-accent' %>" href="<%= item.href %>" data-kt-tooltip="true" data-kt-tooltip-placement="right">
            <i class="ki-filled <%= item.icon %> text-lg w-5 text-center <%= active === item.key ? 'text-primary' : 'text-muted-foreground' %>"></i>
            <span class="lg:group-data-[sidebar-collapsed=true]/shell:hidden"><%= item.label %></span>
            <% if (item.count > 0) { %>
              <span class="kt-badge kt-badge-sm <%= item.badgeClass %> ms-auto lg:group-data-[sidebar-collapsed=true]/shell:hidden"><%= item.count %></span>
            <% } %>
            <span class="kt-tooltip hidden" data-kt-tooltip-content>
              <%= item.label %><% if (item.count > 0) { %> (<%= item.count %>)<% } %>
            </span>
          </a>
        <% }); %>
      </nav>
    </aside>

    <div class="flex flex-col grow lg:ps-[280px] lg:group-data-[sidebar-collapsed=true]/shell:ps-16 min-h-full" data-content-wrapper>
      <header class="sticky top-0 z-20 flex items-stretch shrink-0 bg-background border-b border-border">
        <div class="flex justify-between items-center gap-4 px-4 lg:px-6 w-full h-[70px]">
          <div class="flex items-center gap-2.5">
            <button class="kt-btn kt-btn-icon kt-btn-ghost" data-kt-drawer-toggle="#sidebar" data-sidebar-toggle type="button" title="Ouvrir/fermer le menu">
              <i class="ki-filled ki-burger-menu text-lg"></i>
            </button>
            <span class="text-base font-medium text-mono">NFC Card Manager</span>
          </div>
          <div class="flex items-center gap-3">
            <div data-kt-dropdown="true" data-kt-dropdown-placement="bottom-end" data-kt-dropdown-trigger="click">
              <button class="kt-btn kt-btn-ghost kt-btn-icon rounded-full size-9" data-kt-dropdown-toggle="true" type="button">
                <span class="flex items-center justify-center size-9 rounded-full bg-primary/10 text-primary">
                  <i class="ki-filled ki-user-square text-lg"></i>
                </span>
              </button>
              <div class="kt-dropdown-menu w-[220px]" data-kt-dropdown-menu="true">
                <div class="px-2.5 py-2">
                  <span class="text-sm font-medium text-foreground">Administrateur</span>
                </div>
                <ul class="kt-dropdown-menu-sub">
                  <li><div class="kt-dropdown-menu-separator"></div></li>
                  <li>
                    <form method="POST" action="/admin/logout">
                      <%- include('csrf') %>
                      <button class="kt-dropdown-menu-link w-full text-start" type="submit">
                        <i class="ki-filled ki-exit-right"></i>
                        Déconnexion
                      </button>
                    </form>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </header>

      <main class="grow">
        <div class="mx-auto w-full max-w-[1400px] py-6 px-4 lg:px-6">
