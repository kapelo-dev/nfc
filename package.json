{
  "name": "nfc-card-manager",
  "version": "1.0.0",
  "description": "NFC Card Manager with dynamic subdomains and social profiles",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node scripts/init-db.js"
  },
  "keywords": [
    "nfc",
    "cards",
    "subdomains",
    "social-profiles"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.17.3",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.3",
    "uuid": "^9.0.1"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
