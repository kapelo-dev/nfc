{
  "name": "nfc-card-manager",
  "version": "1.0.0",
  "description": "NFC Card Manager with dynamic subdomains and social profiles",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node scripts/init-db.js",
    "build:css": "tailwindcss -i src/metronic/entry.css -o public/metronic/css/styles.css --minify",
    "watch:css": "tailwindcss -i src/metronic/entry.css -o public/metronic/css/styles.css --watch"
  },
  "keywords": [
    "nfc",
    "cards",
    "subdomains",
    "social-profiles"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.17.3",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "mysql2": "^3.24.3",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.2"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    },
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@keenthemes/ktui": "^1.2.7",
    "@tailwindcss/cli": "^4.3.3",
    "nodemon": "^3.0.2",
    "tailwindcss": "^4.3.3"
  }
}
